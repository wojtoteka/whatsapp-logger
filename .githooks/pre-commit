#!/bin/sh
#
# Blokada sekretów w plikach, które trafiają do repozytorium.
#
# Sprawdza to, co masz w poczekalni (git add), a nie to, co leży na dysku.
# Sekrety mają siedzieć w src/config.local.js, bo ten plik jest w .gitignore.
#
# Włączenie po świeżym klonie:
#     git config core.hooksPath .githooks
#
# Pominięcie w wyjątkowej sytuacji: git commit --no-verify

# Pliki śledzone, w których nie może być wartości wrażliwych
PLIKI="src/config.js src/config.local.example.js"

# Klucze, które muszą zostać puste
KLUCZE="LOCKED_CHAT_PASSWORD|DISCORD_WEBHOOK_URL|DISCORD_PING_USER_ID"

blad=0

komunikat() {
    echo ""
    echo "  BLOKADA: w $1 jest sekret"
    echo ""
    echo "  $2"
    echo ""
    echo "  Przenies wartosc do src/config.local.js (plik jest w .gitignore)"
    echo "  i zostaw tu pusty napis."
    echo ""
}

# 1. Puste pola na sekrety w plikach szablonowych
for plik in $PLIKI; do
    # Plik nie jest w poczekalni, nic do sprawdzenia
    git diff --cached --name-only --diff-filter=ACM | grep -qx "$plik" || continue

    tresc=$(git show ":$plik" 2>/dev/null) || continue

    trafienia=$(printf '%s\n' "$tresc" \
        | grep -nE "^[[:space:]]*($KLUCZE)[[:space:]]*:[[:space:]]*['\"][^'\"]")

    if [ -n "$trafienia" ]; then
        komunikat "$plik" "$(printf '%s' "$trafienia" | head -3)"
        blad=1
    fi
done

# 2. Adres webhooka Discorda w dowolnym pliku idącym do repozytorium
for plik in $(git diff --cached --name-only --diff-filter=ACM); do
    case "$plik" in
        *.js|*.json|*.md|*.txt|*.yml|*.yaml|*.env*) ;;
        *) continue ;;
    esac

    tresc=$(git show ":$plik" 2>/dev/null) || continue

    if printf '%s\n' "$tresc" | grep -qE 'https://(canary\.|ptb\.)?discord(app)?\.com/api/webhooks/[0-9]+/'; then
        komunikat "$plik" "znaleziono pelny adres webhooka Discorda"
        blad=1
    fi
done

if [ "$blad" -ne 0 ]; then
    echo "  Commit wstrzymany. Nic nie zostalo zapisane."
    echo ""
    exit 1
fi

exit 0
