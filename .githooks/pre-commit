#!/bin/sh
#
# Blokada sekretow w tym, co trafia do repozytorium.
#
# Sprawdza poczekalnie (git add), a nie to, co lezy na dysku. Wszystkie
# wartosci wrazliwe maja siedziec w .env, ktory jest w .gitignore.
#
# Wlaczenie po swiezym klonie:
#     git config core.hooksPath .githooks
#
# Pominiecie w wyjatkowej sytuacji: git commit --no-verify

blad=0

komunikat() {
    echo ""
    echo "  BLOKADA: $1"
    echo ""
    echo "  $2"
    echo ""
}

# 1. Sam plik .env nie ma prawa trafic do repozytorium
if git diff --cached --name-only --diff-filter=ACM | grep -qx ".env"; then
    komunikat "plik .env jest w poczekalni" \
        "Ten plik trzyma hasla i webhook. Wyjmij go: git rm --cached .env"
    blad=1
fi

# 2. Szablon .env.example ma miec puste wartosci
if git diff --cached --name-only --diff-filter=ACM | grep -qx ".env.example"; then
    KLUCZE="LOCKED_CHAT_PASSWORD|DISCORD_WEBHOOK_URL|DISCORD_PING_USER_ID"
    trafienia=$(git show ":.env.example" 2>/dev/null \
        | grep -nE "^[[:space:]]*($KLUCZE)[[:space:]]*=[[:space:]]*[^[:space:]]")

    if [ -n "$trafienia" ]; then
        komunikat "w .env.example jest wypelniona wartosc wrazliwa" \
            "$trafienia"
        echo "  Zostaw tam pusta wartosc, a swoja wpisz do .env"
        echo ""
        blad=1
    fi
fi

# 3. Prawdziwy webhook Discorda nie moze sie pojawic w zadnym sledzonym pliku.
#
# Szukamy pelnych danych logowania, a nie samego ksztaltu adresu: ID to
# snowflake (17+ cyfr), a token ma kilkadziesiat znakow. Dzieki temu atrapy
# w testach ("/123/abc") przechodza, a wyciek prawdziwego adresu nie.
WZOR="discord(app)?[.]com/api/webhooks/[0-9]{17,}/[A-Za-z0-9_-]{30,}"

webhooki=$(git diff --cached --name-only --diff-filter=ACM \
    | while read -r plik; do
        git show ":$plik" 2>/dev/null \
            | grep -Eq "$WZOR" && echo "$plik"
      done)

if [ -n "$webhooki" ]; then
    komunikat "adres webhooka Discorda w plikach: $webhooki" \
        "Przenies go do .env (plik jest w .gitignore)."
    blad=1
fi

exit $blad
