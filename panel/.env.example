# ─────────────────────────────────────────────────────────────────────────
#  Panel archiwum - konfiguracja
#
#  Ten plik jest w .gitignore. Dotyczy wyłącznie panelu; ustawienia samego
#  loggera siedzą w .env w katalogu wyżej.
#
#  Uruchamiany przez "npm start" panel dostaje LOGS_DIR, HOSTNAME i PORT
#  wprost od loggera, więc te trzy wartości są tu tylko na wypadek
#  uruchamiania panelu osobno (npm run panel).
# ─────────────────────────────────────────────────────────────────────────

# Klucz, którym podpisywane są ciasteczka sesji. Zmiana wylogowuje wszystkich.
# Nowy generujesz poleceniem:  cd panel && npx auth secret
AUTH_SECRET=

# Folder z archiwum - ten sam, do którego pisze logger.
LOGS_DIR=../logs

# Adres, na którym panel nasłuchuje. Te same możliwości co PANEL_HOST
# w .env katalogu wyżej: 127.0.0.1 (tylko ta maszyna), 0.0.0.0 (cała
# sieć) albo konkretny adres hosta w sieci lokalnej.
HOSTNAME=127.0.0.1

# Port panelu.
PORT=3000

# Tylko przy samodzielnym "npm run panel". Przy zwykłym "npm start" wartość
# jest przekazywana z głównego .env i musi zgadzać się z loggerem.
TAU_ENABLED=false

# ── Baza danych ──────────────────────────────────────────────────────────
#
# Panel czyta stąd wyłącznie konta do logowania (tabela panel_users).
# Rozmowy bierze z plików w LOGS_DIR, nie z bazy.
#
# Konto zakłada logger:  npm start -- --uzytkownik
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=whatsapp
DB_PASSWORD=
DB_NAME=whatsapp_logger
