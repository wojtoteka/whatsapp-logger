# -------------------------------------------------------------------------
#  WhatsApp Logger - cała konfiguracja w jednym pliku
#
#  Skopiuj ten plik jako .env i uzupełnij. Plik .env jest w .gitignore,
#  więc zostaje wyłącznie na Twojej maszynie.
#
#      cp .env.example .env
#
#  Każdą wartość można też podać przez zmienną środowiskową systemu -
#  ta ma pierwszeństwo przed .env. Pusta wartość = ustawienie domyślne.
# -------------------------------------------------------------------------


# -- Sekrety --------------------------------------------------------------

# Kod do zablokowanych czatów WhatsApp (Ustawienia > Prywatność > Blokada czatu).
# Podawany raz, zaraz po połączeniu. Puste = obsługa wyłączona.
LOCKED_CHAT_PASSWORD=

# Discord > kanał > Edytuj kanał > Integracje > Webhooki > Nowy webhook > Kopiuj URL
# Puste = powiadomienia wyłączone.
DISCORD_WEBHOOK_URL=

# ID użytkownika Discord pingowanego przy utracie autoryzacji i przy kodzie QR.
DISCORD_PING_USER_ID=


# -- Parowanie ------------------------------------------------------------

# Ile kodów QR pokazać, zanim logger sam się wyłączy. Niezeskanowany kod
# odświeża się co kilkadziesiąt sekund, więc bez limitu program zostawiony
# na noc zasypuje terminal setkami kodów. Launcher takiego wyjścia nie
# ponawia - sparowanie i tak wymaga człowieka. Pod pm2 albo systemd trzeba to
# jeszcze powiedzieć nadzorcy: patrz ecosystem.config.js i README.
# 0 = bez limitu.
QR_MAX_CODES=3


# -- Archiwum -------------------------------------------------------------

# Folder z archiwum. Ścieżka względna liczy się od katalogu programu.
LOGS_DIR=./logs

# Ile wiadomości mieści jeden plik HTML, zanim zacznie się kolejny.
MESSAGES_PER_FILE=70

# Ile ostatnich wiadomości z każdego już archiwizowanego czatu przejrzeć po
# starcie i dopisać, jeśli logger nie widział ich na żywo. 0 = wyłączone.
# Czaty bez folderu obejmuje jawne: npm start -- --nadrob-wszystko
BACKFILL_MESSAGES_PER_CHAT=250

# Lekka synchronizacja przyrostowa znanych czatów. Każde uruchomienie nadal
# synchronizuje od razu; ta wartość określa tylko kolejne kontrole. 0 = wyłączone.
SYNC_INTERVAL_MINUTES=15

# Typy wiadomości, których pliki mają lądować na dysku (po przecinku).
# Do wyboru: image, video, audio, ptt, document, sticker
# Uwaga: dokumenty i filmy potrafią zająć dużo miejsca.
MEDIA_TYPES=image,video,audio,ptt,document,sticker

# Plik większy niż tyle MB nie zostaje zapisany, ale w archiwum
# pojawia się notatka z typem, nazwą i rozmiarem.
MAX_MEDIA_SIZE_MB=100


# -- Zdjęcia profilowe ----------------------------------------------------

# Pobieranie zdjęć profilowych do logs/_avatars. true / false
# Trzymana jest historia: zmienione zdjęcie dochodzi jako nowa wersja,
# a stara zostaje, więc stare wiadomości pokazują zdjęcie z tamtego czasu.
SAVE_PROFILE_PICS=true

# Co ile dni sprawdzamy, czy ktoś zmienił zdjęcie. Termin liczy się z daty
# zapisanej na dysku, więc postój maszyny go nie resetuje.
AVATAR_REFRESH_DAYS=30


# -- Statusy (relacje) ----------------------------------------------------

# Archiwizowanie relacji do logs/Statusy/<autor>. true / false
SAVE_STATUSES=true

# Co ile godzin program dobiera relacje, które pojawiły się, gdy był
# wyłączony, i sprawdza zaległe zdjęcia profilowe.
SWEEP_CHECK_HOURS=6


# -- Kanały WhatsAppa -----------------------------------------------------

# Archiwizowanie kanałów (WhatsApp Channels). true / false
#
# Domyślnie wyłączone. Kanał to nadajnik, nie rozmowa: subskrybent nic tam
# nie pisze, a nadawca potrafi wrzucić kilkadziesiąt filmów dziennie - po
# kilku subskrypcjach zajmowały one więcej miejsca niż wszystkie prawdziwe
# rozmowy razem. Wyłączenie dotyczy zarówno zapisu na żywo, jak i
# nadrabiania historii; kanały, które trafiły do archiwum wcześniej,
# zostają na dysku nietknięte.
SAVE_CHANNELS=false


# Zapis rozmowy z ChatGPT +1 (800) 242-8478; nie wyłącza ?tau.
SAVE_AI_CHAT=false

# -- Kasowanie starych wiadomości -----------------------------------------

# false = nic się nie kasuje, archiwum rośnie bez końca.
RETENTION_ENABLED=true

# Po ilu dniach znikają pliki HTML, pobrane media i wiadomości oczekujące.
# Zdjęcia profilowe nie podlegają kasowaniu.
RETENTION_DAYS=180

# Co ile godzin program sprawdza, czy jest co skasować.
RETENTION_CHECK_HOURS=12


# -- Panel do przeglądania archiwum ---------------------------------------

# Panel startuje razem z loggerem (npm start) i czyta ten sam folder logs.
# false uruchamia sam logger, bez panelu.
PANEL_ENABLED=true

# Adres, na którym panel nasłuchuje:
#   127.0.0.1     tylko z tej maszyny (domyślnie, najbezpieczniej)
#   0.0.0.0       na wszystkich kartach sieciowych - panel widać z sieci
#   adres LAN      jedna konkretna karta, np. tylko z sieci domowej
# Samo IP albo nazwa hosta: bez http:// i bez portu (port jest niżej).
# Uwaga: 0.0.0.0 na serwerze z publicznym IP wystawia panel na świat -
# wtedy jedyną ochroną archiwum jest hasło do logowania.
PANEL_HOST=127.0.0.1

# Port, pod którym panel nasłuchuje. Otwiera się na http://localhost:3000
PANEL_PORT=3000

# Wpuszczaj do panelu wyłącznie klientów z sieci lokalnej.
#
# Sam PANEL_HOST tego nie załatwia: router z DMZ albo przekierowaniem portu
# przekazuje ruch z internetu na ten sam adres LAN, na którym stoi panel.
# Przy PANEL_LAN_ONLY=true panel Next.js siada na 127.0.0.1, a na
# PANEL_HOST:PANEL_PORT stoi bramka, która sprawdza adres drugiego końca
# połączenia - nagłówka X-Forwarded-For nie da się tu podrobić.
# Obcy nie dostaje żadnej odpowiedzi: bramka zrywa gniazdo, więc z internetu
# port wygląda tak, jakby nic za nim nie stało.
# Wpuszczane są adresy 10.x, 172.16-31.x, 192.168.x, 127.x, 169.254.x
# oraz ich odpowiedniki w IPv6.
PANEL_LAN_ONLY=true

# Adresy spoza sieci prywatnych, które mimo to mają wejść - po przecinku.
# Pojedynczy adres albo zakres CIDR. Przydaje się przy VPN-ie, np. Tailscale,
# który używa zakresu 100.64.0.0/10 spoza sieci prywatnych.
# PANEL_ALLOWED_IPS=100.64.0.0/10,203.0.113.7
PANEL_ALLOWED_IPS=


# -- Prywatny asystent ?tau ----------------------------------------------

# Włącza polecenie ?tau oraz formularz AI w panelu. Dane są wysyłane przez
# zwykły chat WhatsApp do numeru providera, więc włącz to świadomie.
TAU_ENABLED=false

# 1-800-CHATGPT, zapisany wyłącznie cyframi.
TAU_PROVIDER_NUMBER=18002428478

# Maksymalny czas oczekiwania na odpowiedź providera.
TAU_TIMEOUT_SECONDS=120

# Provider dostaje wyłącznie tekst z ostatnich maksymalnie 200 wiadomości.
TAU_MAX_MESSAGES=200

# Ochrona przed przekroczeniem rozmiaru jednej wiadomości WhatsApp.
TAU_MAX_CONTEXT_CHARS=40000


# -- Baza danych (MariaDB / MySQL) ----------------------------------------

# Baza danych. Potrzebna do dwóch rzeczy:
#   1. logowania do panelu (konta siedzą w tabeli panel_users),
#   2. opcjonalnej kopii wiadomości w SQL-u, jeśli chcesz po nich szukać.
#
# Same rozmowy panel czyta z plików w LOGS_DIR, więc bez bazy też je pokaże -
# tyle że wtedy nie ma się jak zalogować.
#
# Założenie bazy i użytkownika (raz, w konsoli MariaDB):
#   CREATE DATABASE whatsapp_logger CHARACTER SET utf8mb4 COLLATE utf8mb4_unicode_ci;
#   CREATE USER 'whatsapp'@'localhost' IDENTIFIED BY 'twoje_haslo';
#   GRANT ALL PRIVILEGES ON whatsapp_logger.* TO 'whatsapp'@'localhost';
#
# Tabele program zakłada sam przy pierwszym połączeniu.
#   npm start -- --baza          sprawdź połączenie i załóż tabele
#   npm start -- --uzytkownik    załóż konto do panelu
DB_ENABLED=false
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=whatsapp
DB_PASSWORD=
DB_NAME=whatsapp_logger


# -- Przeglądarka i diagnostyka -------------------------------------------

# Ścieżka do Chrome/Chromium. Puste = program znajduje ją sam.
CHROME_PATH=

# false pokazuje okno przeglądarki - przydatne, gdy coś nie działa.
HEADLESS=true

# Ile szczegółów w konsoli: debug, info, warn, error
LOG_LEVEL=info

# Minimalny odstęp między zapisami _state.json w milisekundach.
# Chroni dysk przy ruchliwych grupach. 0 = zapis po każdej wiadomości.
STATE_SAVE_INTERVAL_MS=5000
